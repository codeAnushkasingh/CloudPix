# ==============================================================================
# CloudPix - Configuration Environment Variables (.env)
# ==============================================================================
# Copy this file to '.env' in the project root to configure your environment:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
# ==============================================================================

# --- Flask Server Settings ---
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=cloudpix-super-secret-dev-key-change-in-production

# --- Storage Mode Configuration ---
# Options:
#   auto   - Automatically uses S3 if bucket & credentials/IAM role exist;
#            otherwise falls back safely to 'local' demo mode. (RECOMMENDED)
#   s3     - Force AWS S3 mode (will fail if S3 is unreachable).
#   local  - Force Local Demo Mode (stores files in backend/uploads/).
STORAGE_MODE=auto

# --- AWS S3 Bucket Settings ---
# Required when using AWS S3 storage mode.
S3_BUCKET_NAME=your-cloudpix-bucket-name
AWS_REGION=us-east-1

# --- AWS Credentials (OPTIONAL on EC2 with IAM Roles) ---
# NOTE: If deploying on an AWS EC2 instance with an IAM Role attached, leave
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY blank! Boto3 will automatically
# retrieve temporary credentials from the EC2 Instance Metadata Service (IMDS).
# For local development with your personal AWS account, supply them here:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Security & Upload Constraints ---
# Max file size in bytes (default: 5 MB = 5242880 bytes)
MAX_CONTENT_LENGTH=5242880

# Presigned URL expiration time in seconds (default: 3600 = 1 hour)
PRESIGNED_URL_EXPIRY=3600

